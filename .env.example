# Copy to `.env` (git-ignored) and replace every CHANGE_ME value.
# `.env` is read by the application, by the TypeORM CLI and by docker compose.

# --- Development database (used by `pnpm start:dev`) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=trainer
DB_PASSWORD=CHANGE_ME
DB_NAME=claude_trainer

# --- Test database (used ONLY by the integration / e2e test commands) ---
# The test suites read TEST_DB_* and never DB_*, and refuse to run unless
# TEST_DB_NAME ends with "_test". It is a separate container on another port.
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_USER=trainer_test
TEST_DB_PASSWORD=CHANGE_ME
TEST_DB_NAME=claude_trainer_test

# --- Optional ---
# PORT=3000
# DB_RETRY_ATTEMPTS=3     # connection attempts at startup (default 3)
# DB_RETRY_DELAY_MS=1000  # delay between attempts (default 1000)
# DB_LOGGING=false        # set to true to log SQL (dev only; it can contain data)
